{
  "name": "hashline-skill",
  "version": "0.1.0",
  "description": "Hashline content-addressed editing skill",
  "openclaw": {
    "extensions": ["./index.ts"],
    "skills": ["./"],
    "configSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferGo": {
          "type": "boolean",
          "default": true,
          "description": "Prefer Go binary over Node.js if available"
        },
        "logEnabled": {
          "type": "boolean",
          "default": false,
          "description": "If true, logs edit attempts to the metrics file"
        },
        "logPath": {
          "type": "string",
          "default": "~/.openclaw/hashline_metrics.log",
          "description": "Override the path for the metrics log"
        }
      }
    }
  }
}
